<Window x:Class="HeroArena.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hero Arena - Connexion" Height="350" Width="300"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" VerticalAlignment="Center">

        <TextBlock Text="HERO ARENA" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Nom d'utilisateur :" Margin="0,0,0,5" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Height="25" />

        <TextBlock Text="Mot de passe :" Margin="0,0,0,5" />
        <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,15" Height="25" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" />

        <Button Content="Se connecter" Command="{Binding LoginCommand}" Height="30" Margin="0,0,0,10" Background="LightGreen" />

        <Button Content="Créer un compte" Command="{Binding RegisterCommand}" Height="30" Margin="0,0,0,10" />

        <Button Content="⚙️ Paramètres BDD" Command="{Binding OpenSettingsCommand}" Height="30" Background="LightGray" />

    </StackPanel>
</Window>