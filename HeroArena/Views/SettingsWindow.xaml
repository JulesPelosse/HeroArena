<Window x:Class="HeroArena.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres de la base de données" Height="350" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ Configuration de la base de données" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <GroupBox Grid.Row="1" Header="Chaîne de connexion" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" 
                         TextWrapping="Wrap" FontFamily="Consolas" Padding="5"/>
                <Button Content="💾 Sauvegarder" Command="{Binding SaveConnectionCommand}"
                        Margin="0,10,0,0" Padding="10,5" HorizontalAlignment="Right"
                        Background="#3498DB" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Initialisation de la base" Padding="10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                    Cliquez sur le bouton ci-dessous pour créer les tables et insérer les données par défaut (héros, sorts, utilisateur admin).
                </TextBlock>
                <Button Content="🔄 Initialiser la base de données" 
                        Command="{Binding InitializeDatabaseCommand}"
                        Padding="10,5" Background="#E67E22" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" 
                   FontSize="14" Margin="0,15,0,0" VerticalAlignment="Top"
                   Foreground="#27AE60" FontWeight="SemiBold"/>

        <Button Grid.Row="4" Content="Fermer" Click="CloseButton_Click"
                Padding="15,5" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>