<Window x:Class="HeroArena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HeroArena.ViewModels"
        Title="Hero Arena" Height="450" Width="800">
    <Window.DataContext>
            <vm:MainVMX />
    </Window.DataContext>
    <Grid Background="#2c3e50">
        <ListBox ItemsSource="{Binding HeroesList}" 
                 DisplayMemberPath="Name" 
                 Width="200" 
                 Height="100" 
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"/>
    </Grid>
</Window>