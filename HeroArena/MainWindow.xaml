<Window x:Class="HeroArena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeroArena"
        Title="Hero Arena" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
    </Window.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}">

        <TabItem Header="🛡️ Héros">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Héros Disponibles" Grid.Column="0" Margin="5" Padding="5">
                    <ListBox ItemsSource="{Binding HeroesList}" 
                             SelectedItem="{Binding SelectedHero}"
                             DisplayMemberPath="Name"
                             FontSize="14"/>
                </GroupBox>

                <GroupBox Header="Fiche du Personnage" Grid.Column="1" Margin="5" Padding="15">
                    <Grid DataContext="{Binding SelectedHero}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <TextBlock Text="Points de Vie : " FontSize="16"/>
                                <TextBlock Text="{Binding Health}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="Sorts de Combat :" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Spells}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" Margin="0,5" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Damage, StringFormat={}{0} DMG}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </TabItem>

        <TabItem Header="✨ Sorts">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📜 Liste des Sorts" FontSize="24" Margin="0,0,0,15"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Filtrer par héro : " VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="200" ItemsSource="{Binding HeroesList}" DisplayMemberPath="Name" SelectionChanged="HeroFilterCombo_SelectionChanged"/>
                    <Button Content="Tout afficher" Margin="10,0,0,0" Click="ShowAllSpells_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding SpellsList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="2" Margin="0,5" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Damage, StringFormat={}{0} DMG}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <TabItem Header="⚔️ Combat">
            <Grid Margin="15">
                <TextBlock Text="⚠️ Sélectionne un héros dans le premier onglet avant de combattre"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedHero, Converter={StaticResource NullToVisibilityConverter}}"/>

                <Button Content="🎮 Commencer le Combat"
                        Command="{Binding StartCombatCommand}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,10" FontSize="18"
                        Visibility="{Binding SelectedHero, Converter={StaticResource NotNullToVisibilityConverter}}"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>